{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ONNX inference",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/onnx_exporter",
            "args": ["${workspaceFolder}/model/lenet.onnx"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug ONNX test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/onnx_exporter_test",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug ESP32-S3 QEMU",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/esp32/build/edgeml.elf",
            "cwd": "${workspaceFolder}/esp32",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:HOME}/.espressif/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
            "miDebuggerArgs": "-nx",
            "miDebuggerServerAddress": "localhost:3333",
            "stopAtConnect": true,
            "launchCompleteCommand": "None",
            "externalConsole": false
        }        
    ]
}
