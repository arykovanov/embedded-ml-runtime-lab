{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ONNX inference",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/onnx_exporter",
            "args": ["${workspaceFolder}/model/lenet.onnx"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
